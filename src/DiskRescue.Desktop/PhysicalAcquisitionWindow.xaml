<Window x:Class="DiskRescue.Desktop.PhysicalAcquisitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Physical disk acquisition · Experimental"
        Height="760" Width="980" MinHeight="680" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="#0B1422"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="PHYSICAL DISK ACQUISITION" Foreground="#57D6E8" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="Create a verified read-only disk image" Foreground="#E8F0FA" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,4"/>
            <TextBlock Text="Experimental Windows workflow · Source is opened read-only · Destination must be another physical disk" Foreground="#9FB0C5" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#3B2B1C" BorderBrush="#A66A32" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <TextBlock Foreground="#FFD9A8" TextWrapping="Wrap" FontWeight="SemiBold">
                SAFETY WARNING: A read-only handle does not stop Windows or other programs from writing through mounted volumes. This is a live, non-resumable copy—not a hardware write-blocked forensic image or a point-in-time snapshot. Use a hardware write blocker for irreplaceable media. Do not use this experimental workflow on your only copy of valuable data until disposable-disk and hardware validation is complete.
            </TextBlock>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SOURCE PHYSICAL DISK" Foreground="#9FB0C5" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="DiskCombo" SelectionChanged="DiskCombo_SelectionChanged" MinHeight="36" Padding="8"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh inventory" Click="Refresh_Click" Margin="10,22,0,0" Padding="14,8"/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="#142236" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SOURCE &amp; DESTINATION PREFLIGHT" Foreground="#57D6E8" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="PreflightBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#0C1726" Foreground="#E8F0FA" BorderThickness="0" Padding="12" Text="Loading physical-disk inventory…"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#142236" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="IMAGE DESTINATION" Foreground="#57D6E8" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Choose a new image file on separate physical storage. The directory must already exist." Foreground="#9FB0C5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DestinationBox" MinHeight="34" VerticalContentAlignment="Center" Background="#0C1726" Foreground="#E8F0FA" BorderBrush="#30445D" TextChanged="DestinationBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseDestination_Click" Margin="8,0,0,0" Padding="12,6"/>
                        </Grid>
                        <TextBlock Text="TYPE THE CONFIRMATION PHRASE" Foreground="#9FB0C5" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ConfirmationBox" MinHeight="34" VerticalContentAlignment="Center" Background="#0C1726" Foreground="#E8F0FA" BorderBrush="#30445D" TextChanged="ConfirmationBox_TextChanged"/>
                        <TextBlock x:Name="ConfirmationHint" Text="The exact phrase will be shown after source selection." Foreground="#9FB0C5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="DestinationStatusText" DockPanel.Dock="Bottom" Foreground="#F2B66D" TextWrapping="Wrap" Margin="0,12,0,0" Text="Destination not checked."/>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProgressText" Text="Ready · no physical source has been opened" Foreground="#9FB0C5"/>
                <ProgressBar x:Name="AcquireProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Margin="10,0" Padding="18,10" Background="#30445D"/>
            <Button Grid.Column="2" x:Name="AcquireButton" Content="Acquire verified image" Click="Acquire_Click" IsEnabled="False" Padding="20,10" Background="#176B65"/>
        </Grid>
        <TextBlock Grid.Row="5" x:Name="ResultText" Foreground="#A7F0D5" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</Window>