<Application x:Class="DiskRescue.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
<Style TargetType="{x:Type Window}">
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
</Style>
<Style x:Key="DiskRescueKeyboardFocus" TargetType="{x:Type Control}">
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="{x:Type Control}">
        <Border BorderBrush="{StaticResource Accent}" BorderThickness="2"
                CornerRadius="4" Background="Transparent">
          <AdornedElementPlaceholder/>
        </Border>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>
<SolidColorBrush x:Key="Canvas" Color="#0B1220"/><SolidColorBrush x:Key="Panel" Color="#111D2E"/><SolidColorBrush x:Key="Text" Color="#E8F0FA"/><SolidColorBrush x:Key="Muted" Color="#91A4BA"/><SolidColorBrush x:Key="Accent" Color="#31C5D8"/><SolidColorBrush x:Key="Warn" Color="#F2A65A"/>

<Style TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{StaticResource DiskRescueKeyboardFocus}"/>
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Foreground" Value="#06131D"/>
  <Setter Property="Background" Value="{StaticResource Accent}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="18,11"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
      <Setter Property="Background" Value="#253348"/>
      <Setter Property="Foreground" Value="#8294A9"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Trigger>
  </Style.Triggers>
</Style>
<Style TargetType="ComboBox">
  <Setter Property="FocusVisualStyle" Value="{StaticResource DiskRescueKeyboardFocus}"/>
  <Setter Property="Background" Value="#0C1726"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="BorderBrush" Value="#30445D"/>
  <Setter Property="Padding" Value="8,6"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="ToggleButton"
                        Focusable="False"
                        ClickMode="Press"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                  <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#91A4BA"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            Margin="10,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                 AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  SnapsToDevicePixels="True">
              <Border Background="{StaticResource Panel}" BorderBrush="#30445D" BorderThickness="1" CornerRadius="6"/>
              <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
              </ScrollViewer>
            </Grid>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>
<Style TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="Background" Value="{StaticResource Panel}"/>
  <Setter Property="Padding" Value="10,8"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True">
            <Setter TargetName="ItemBorder" Property="Background" Value="#203B55"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="ItemBorder" Property="Background" Value="#183B3E"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>
<Style TargetType="DataGridColumnHeader">
  <Setter Property="Background" Value="#17283D"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="BorderBrush" Value="#263A52"/>
  <Setter Property="BorderThickness" Value="0,0,1,1"/>
  <Setter Property="Padding" Value="10,8"/>
  <Setter Property="FontWeight" Value="Bold"/>
</Style>
<Style TargetType="DataGridCell">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="8,6"/>
  <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
      <Setter Property="Background" Value="#183B3E"/>
      <Setter Property="Foreground" Value="#A7F0D5"/>
    </Trigger>
  </Style.Triggers>
</Style>
<Style TargetType="TabItem">
  <Setter Property="FocusVisualStyle" Value="{StaticResource DiskRescueKeyboardFocus}"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="Background" Value="{StaticResource Panel}"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                CornerRadius="6,6,0,0">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="TabBorder" Property="Background" Value="#183B3E"/>
            <Setter Property="Foreground" Value="#A7F0D5"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="TabBorder" Property="Background" Value="#1A2B40"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>

<Style TargetType="TextBox">
  <Setter Property="FocusVisualStyle" Value="{StaticResource DiskRescueKeyboardFocus}"/>
  <Setter Property="Background" Value="#0C1726"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="BorderBrush" Value="#30445D"/>
  <Setter Property="Padding" Value="10,8"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="MinHeight" Value="34"/>
</Style>
<Style TargetType="DataGrid">
  <Setter Property="FocusVisualStyle" Value="{StaticResource DiskRescueKeyboardFocus}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="RowHeight" Value="34"/>
  <Setter Property="MinRowHeight" Value="30"/>
  <Setter Property="ColumnHeaderHeight" Value="36"/>
  <Setter Property="Background" Value="#111D2E"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#263A52"/><Setter Property="RowBackground" Value="#111D2E"/><Setter Property="AlternatingRowBackground" Value="#152338"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#263A52"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
</Application.Resources></Application>