<Application x:Class="DiskRescue.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
<SolidColorBrush x:Key="Canvas" Color="#0B1220"/><SolidColorBrush x:Key="Panel" Color="#111D2E"/><SolidColorBrush x:Key="Text" Color="#E8F0FA"/><SolidColorBrush x:Key="Muted" Color="#91A4BA"/><SolidColorBrush x:Key="Accent" Color="#31C5D8"/><SolidColorBrush x:Key="Warn" Color="#F2A65A"/>
<Style TargetType="Button"><Setter Property="Foreground" Value="#06131D"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#0C1726"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#30445D"/><Setter Property="Padding" Value="10,8"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="#111D2E"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#263A52"/><Setter Property="RowBackground" Value="#111D2E"/><Setter Property="AlternatingRowBackground" Value="#152338"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#263A52"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
</Application.Resources></Application>