<Window x:Class="DiskRescue.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DiskRescue Pro" Height="800" Width="1280" MinHeight="680" MinWidth="1050" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DISKRESCUE PRO" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Disk image inspection" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Understand the disk structure before taking any recovery decision." Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel><Border Grid.Column="1" Background="#183B3E" CornerRadius="14" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="●  READ-ONLY MODE" Foreground="#A7F0D5" FontSize="11" FontWeight="Bold"/></Border></Grid>
<Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="SOURCE IMAGE" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ImagePathBox" IsReadOnly="True" Text="Select a disk image file (.img, .bin, .dd, .raw)..." Margin="0,0,12,0"/><Button Grid.Column="1" Content="Browse image" Click="Browse_Click" x:Name="BrowseButton"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,14,0"><TextBlock Text="Sector size" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="SectorSizeBox" Width="90" SelectedIndex="0" Padding="7,6" Background="#0C1726" Foreground="#E8F0FA"><ComboBoxItem Content="512 B" Tag="512"/><ComboBoxItem Content="4 KB" Tag="4096"/></ComboBox></StackPanel><Button Grid.Column="3" Content="Inspect image  →" Click="Inspect_Click" x:Name="InspectButton" Padding="20,11"/><Button Grid.Column="4" Content="Find lost partitions" Click="Discover_Click" x:Name="DiscoverButton" Padding="16,11" Background="#F2A65A"/><Button Grid.Column="5" Content="Physical disks / acquire image…" Click="PhysicalDiskInventory_Click" x:Name="PhysicalDiskButton" Padding="12,11" Margin="8,0,0,0" Background="#183B3E"/></Grid></Grid></Border>
<Grid Grid.Row="2" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Panel}" CornerRadius="10" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="IMAGE SIZE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ImageSizeText" Text="—" Foreground="{StaticResource Text}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="PARTITIONS FOUND" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PartitionCountText" Text="—" Foreground="{StaticResource Text}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="PARTITION TABLE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TableTypeText" Text="—" Foreground="{StaticResource Text}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="10" Padding="15"><StackPanel><TextBlock Text="VALIDATION" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ValidationText" Text="Not inspected" Foreground="{StaticResource Warn}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></Grid>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,12,0"><TabControl Background="{StaticResource Panel}" BorderThickness="0">
<TabItem Header="Partitions"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,13"><TextBlock Text="Partition overview" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select a partition to enable a read-only NTFS preview." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><DataGrid x:Name="PartitionsGrid" AlternationCount="2" SelectionChanged="PartitionsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/><DataGridTextColumn Header="TABLE" Binding="{Binding Table}" Width="65"/><DataGridTextColumn Header="PARTITION NAME / TYPE" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="START LBA" Binding="{Binding StartLba}" Width="100"/><DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="NTFS file preview"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Read-only NTFS preview" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Scans a bounded number of MFT records from the selected partition. This is not file recovery." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/><Button x:Name="ScanNtfsButton" Content="Scan selected partition" Click="ScanNtfs_Click" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel><TreeView x:Name="NtfsTreeView" Background="#0C1726" Foreground="{StaticResource Text}" BorderThickness="0"/></DockPanel></TabItem>
</TabControl></Border>
<Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Inspection findings" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Validation notes and limitations" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="FindingsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#0C1726" Padding="14" Text="No inspection has been run. Select a regular disk-image file to begin."/></DockPanel></Border></Grid>
<Grid Grid.Row="4" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Ready · Image inspection and physical-disk inventory" Foreground="{StaticResource Muted}"/><TextBlock Text="Physical-disk inventory includes conservative boot-device checks. Experimental physical imaging is available with strict preflight and confirmation. Physical partition scanning, repair, and recovery remain disabled." Foreground="#71869D" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock x:Name="ScanProgressText" Text="Ready" Foreground="{StaticResource Muted}" FontSize="10"/><ProgressBar x:Name="ScanProgressBar" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,0"/><Button x:Name="CancelScanButton" Content="Cancel scan" Click="CancelScan_Click" IsEnabled="False" Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Left" Background="#30445D" Foreground="{StaticResource Text}"/></StackPanel><Button Grid.Column="2" x:Name="ExportButton" Content="Export JSON report" Click="Export_Click" IsEnabled="False" Background="#22354B" Foreground="{StaticResource Text}"/></Grid>
</Grid></Window>