<Window x:Class="DiskRescue.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskRescue Pro"
        Height="900" Width="1440" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{StaticResource Canvas}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product identity and operating boundary -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DISKRESCUE PRO" Foreground="{StaticResource Accent}"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Disk inspection" Foreground="{StaticResource Text}"
                           FontSize="28" FontWeight="SemiBold" Margin="0,3,0,2"/>
                <TextBlock Text="Inspect the image, review the evidence, and choose a safe next step."
                           Foreground="{StaticResource Muted}" FontSize="13"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#153A35" BorderBrush="#28675B"
                    BorderThickness="1" CornerRadius="8" Padding="14,9"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#65D6B2" Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="IMAGE SOURCE · READ ONLY" Foreground="#B5F1DC"
                               FontSize="10" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Source selection: two calm rows instead of one crowded toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#263A52"
                BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="01  /  SOURCE IMAGE" Foreground="{StaticResource Muted}"
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ImagePathBox" IsReadOnly="True"
                             Text="Choose a disk image (.img, .bin, .dd, .raw)"
                             VerticalContentAlignment="Center" MinHeight="34"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse files…"
                            Click="Browse_Click" MinWidth="120" MinHeight="34"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Logical sector size" Foreground="{StaticResource Muted}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <ComboBox x:Name="SectorSizeBox" Width="94" SelectedIndex="0"
                                  Padding="7,5" Background="#0C1726" Foreground="{StaticResource Text}">
                            <ComboBoxItem Content="512 bytes" Tag="512"/>
                            <ComboBoxItem Content="4 KB" Tag="4096"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="InspectButton" Content="Inspect image"
                            Click="Inspect_Click" Padding="16,7" Margin="12,0,0,0"
                            MinHeight="32"/>
                    <Button Grid.Column="2" x:Name="DiscoverButton" Content="Find lost partitions"
                            Click="Discover_Click" Padding="15,7" Margin="8,0,0,0" MinHeight="32"
                            Background="#8A5526" Foreground="#FFF1DF"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Compact scan summary -->
        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="9" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="IMAGE SIZE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="ImageSizeText" Text="—" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="9" Padding="13" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="PARTITIONS" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="PartitionCountText" Text="—" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="9" Padding="13" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="TABLE TYPE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="TableTypeText" Text="—" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="9" Padding="13">
                <StackPanel>
                    <TextBlock Text="VALIDATION" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="ValidationText" Text="Awaiting inspection" Foreground="{StaticResource Warn}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Partition map -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="#263A52"
                BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="02  /  DISK LAYOUT" Foreground="{StaticResource Muted}"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Partition boundaries and unallocated image space"
                                   Foreground="{StaticResource Text}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Hover over a segment for exact offsets and sizes"
                               Foreground="{StaticResource Muted}" FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Background="#0A1422" CornerRadius="6" Padding="3">
                    <Canvas x:Name="PartitionMapCanvas" Height="50" ClipToBounds="True"
                            SizeChanged="PartitionMapCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main work area -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="0.95*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="#263A52"
                    BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,12,0">
                <TabControl Background="{StaticResource Panel}" BorderThickness="0">
                    <TabItem Header="Image navigator">
                        <DockPanel Margin="2,12,2,2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Image and partition hierarchy" Foreground="{StaticResource Text}"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Select a node to synchronize the partition inventory, map highlight and inspector."
                                           Foreground="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TreeView x:Name="ImageNavigatorTree" Background="#0C1726"
                                      Foreground="{StaticResource Text}" BorderThickness="1"
                                      BorderBrush="#263A52" Padding="8"
                                      SelectedItemChanged="ImageNavigatorTree_SelectedItemChanged">
                                <TreeViewItem Header="No image loaded" IsEnabled="False"/>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Partitions">
                        <DockPanel Margin="2,12,2,2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Partition overview" Foreground="{StaticResource Text}"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Select a partition to inspect its available read-only metadata."
                                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="PartitionsGrid" AlternationCount="2"
                                      SelectionChanged="PartitionsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42"/>
                                    <DataGridTextColumn Header="TABLE" Binding="{Binding Table}" Width="70"/>
                                    <DataGridTextColumn Header="PARTITION / TYPE" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="START LBA" Binding="{Binding StartLba}" Width="105"/>
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Lost candidates">
                        <DockPanel Margin="2,12,2,2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Discovery evidence" Foreground="{StaticResource Text}"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Candidates are evidence for review, not recovered or restored partitions."
                                           Foreground="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="CandidateEvidenceBox" DockPanel.Dock="Bottom"
                                     Height="92" Margin="0,9,0,0" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="1"
                                     BorderBrush="#263A52" Background="#0C1726" Padding="10"
                                     Text="Select a candidate to review its validation evidence."/>
                            <DataGrid x:Name="CandidatesGrid" ItemsSource="{Binding}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      SelectionChanged="CandidatesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="60"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="130"/>
                                    <DataGridTextColumn Header="BYTE OFFSET" Binding="{Binding Offset}" Width="120"/>
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="95"/>
                                    <DataGridTextColumn Header="CONF." Binding="{Binding Confidence}" Width="65"/>
                                    <DataGridTextColumn Header="BACKUP" Binding="{Binding BackupEvidence}" Width="85"/>
                                    <DataGridTextColumn Header="OVERLAP" Binding="{Binding PartitionRelation}" Width="*"/>
                                    <DataGridTextColumn Header="REVIEW GUIDANCE" Binding="{Binding Advisory}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="File entries">
                        <DockPanel Margin="2,12,2,2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="NTFS file entries" Foreground="{StaticResource Text}"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Bounded MFT metadata preview. Filenames and attributes only; this is not file-content recovery."
                                           Foreground="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,9"/>
                                <TextBox x:Name="NtfsEntrySearchBox"
                                         ToolTip="Search names, record numbers, parent references, and attributes"
                                         TextChanged="NtfsEntrySearchBox_TextChanged"
                                         Height="34" Padding="9,6"/>
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="CheckRecoveryDestinationButton"
                                            Content="Check destination…" Click="CheckRecoveryDestination_Click"
                                            IsEnabled="False" Margin="0,0,7,6"/>
                                    <Button x:Name="RecoverDeletedFileButton"
                                            Content="Queue selected deleted files…" Click="RecoverDeletedFile_Click"
                                            IsEnabled="False" Margin="0,0,7,6"/>
                                    <Button x:Name="CancelRecoveryButton" Content="Cancel export"
                                            Click="CancelRecovery_Click" IsEnabled="False"
                                            Margin="0,0,7,6" Background="#30445D"
                                            Foreground="{StaticResource Text}"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <ProgressBar x:Name="RecoveryProgressBar" Height="7"
                                             Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="RecoveryProgressText"
                                           Text="No export operation running."
                                           Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="NtfsEntryDetailsBox" DockPanel.Dock="Bottom"
                                     Height="76" Margin="0,9,0,0" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="1"
                                     BorderBrush="#263A52" Background="#0C1726" Padding="10"
                                     Text="Run an NTFS preview, then select an entry to inspect its metadata."/>
                            <DataGrid x:Name="RecoveryQueueGrid" DockPanel.Dock="Bottom" Height="115" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="QUEUED FILE" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="MFT RECORD" Binding="{Binding RecordNumber}" Width="95"/><DataGridTextColumn Header="MAX BYTES" Binding="{Binding MaximumBytes}" Width="110"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid>
<DataGrid x:Name="NtfsEntriesGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserSortColumns="True"
                                      SelectionMode="Single"
                                      SelectionChanged="NtfsEntriesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding EntryType}" Width="75"/>
                                    <DataGridTextColumn Header="RECORD" Binding="{Binding RecordNumber}" Width="85"/>
                                    <DataGridTextColumn Header="PARENT" Binding="{Binding ParentReference}" Width="95"/>
                                    <DataGridTextColumn Header="SIZE (BYTES)" Binding="{Binding SizeBytes}" Width="110"/>
                                    <DataGridTextColumn Header="ATTRIBUTES" Binding="{Binding Attributes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="NTFS preview">
                        <DockPanel Margin="2,12,2,2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Read-only NTFS preview" Foreground="{StaticResource Text}"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Scans a bounded number of MFT records from the selected partition. It does not recover file contents."
                                           Foreground="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Button x:Name="ScanNtfsButton" Content="Scan selected partition"
                                        Click="ScanNtfs_Click" IsEnabled="False"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TreeView x:Name="NtfsTreeView" Background="#0C1726"
                                      Foreground="{StaticResource Text}" BorderThickness="0"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#263A52"
                          ShowsPreview="True" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

            <!-- Findings panel is a readable report surface, not a console -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#263A52"
                    BorderThickness="1" CornerRadius="11" Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,11">
                        <TextBlock Text="03  /  SELECTED ITEM" Foreground="{StaticResource Muted}"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Partition inspector" Foreground="{StaticResource Text}"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBox x:Name="SelectedPartitionDetailsBox" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="150"
                                 Margin="0,8,0,12" BorderThickness="1"
                                 BorderBrush="#263A52" Background="#0C1726" Padding="10"
                                 Text="Inspect an image and select a partition to review its geometry and validation context."/>
                        <TextBlock Text="03  /  INSPECTION REPORT" Foreground="{StaticResource Muted}"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Findings &amp; guidance" Foreground="{StaticResource Text}"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="Validation results, warnings, and limitations"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        <Border Background="#2D2222" BorderBrush="#8E4545" BorderThickness="1"
                                CornerRadius="6" Padding="9" Margin="0,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚠" Foreground="#F07878" FontWeight="Bold"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           Text="Image inspection is read-only. Physical partition scanning, repair, and recovery are disabled."
                                           Foreground="#F0DADA" FontSize="10" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBox x:Name="FindingsBox" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             BorderThickness="1" BorderBrush="#263A52"
                             Background="#0C1726" Padding="12"
                             Text="No inspection has been run. Choose a regular disk-image file to begin."/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Persistent status and secondary tools -->
        <Grid Grid.Row="5" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready · Image inspection"
                           Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="Image inspection is read-only. Physical partition scanning, repair, and recovery are disabled."
                           Foreground="#71869D" FontSize="9" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Width="150" Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="ScanProgressText" Text="Ready"
                           Foreground="{StaticResource Muted}" FontSize="10"/>
                <ProgressBar x:Name="ScanProgressBar" Height="5" Minimum="0"
                             Maximum="100" Value="0" Margin="0,5,0,0"/>
                <Button x:Name="CancelScanButton" Content="Cancel scan"
                        Click="CancelScan_Click" IsEnabled="False" Padding="7,2"
                        Margin="0,3,0,0" HorizontalAlignment="Left"
                        Background="#30445D" Foreground="{StaticResource Text}"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="ExportButton" Content="Export JSON report"
                    Click="Export_Click" IsEnabled="False" Margin="8,0,0,0"
                    Background="#22354B" Foreground="{StaticResource Text}"/>
            <Button Grid.Column="3" x:Name="PhysicalDiskButton"
                    Content="Advanced device tools…"
                    Click="PhysicalDiskInventory_Click" Padding="12,9"
                    Margin="8,0,0,0" Background="#183B3E" Foreground="#A7F0D5"/>
        </Grid>
    </Grid>
</Window>